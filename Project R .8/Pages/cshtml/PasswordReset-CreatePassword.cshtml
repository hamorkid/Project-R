@page
@model Project_R_._8.Pages.cshtml.PasswordReset_CreatePasswordModel
@{
	ViewData["Title"] = "Reset Your Password";
}

<div class="login-paper">
    <h1><u>Login</u></h1>

    <form method="post" id="newPassForm">
        @Html.AntiForgeryToken()

        <span id="NewPassword_SetNewPasswordError" class="ErrorMess"></span>
        <div class="login-row">
            <label>New Password: </label>
            <input type="password" asp-for="Password" id="newPassword_SetNewPassword" required />
        </div>

        <span id="confirmation_SetNewPasswordError" class="ErrorMess"></span>
        <div class="login-row">
            <label>ReType New Password: </label>
            <input type="password" asp-for="RePassword" id="confirmation_SetNewPassword" required />
        </div>

        <div class="login-reset-button">
            <div>
                <input type="submit" id="submit" name="submit" value="Login">
            </div>
            <div>
                <input type="reset" id="reset" name="reset" value="Reset">
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/Validation.js" asp-append-version="true"></script>
}