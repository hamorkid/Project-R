@page
@model Project_R_._8.Pages.cshtml.PasswordReset_CreatePasswordModel
@{
	ViewData["Title"] = "Reset Your Password";
}

<div class="login-paper">
    <h1><u>Login</u></h1>

    <form onsubmit="return ValidateForm_SetNewPassword()">
        <div class="login-row">
            <label>New Password: </label>
            <input type="password" id="newPassword_SetNewPassword" name="Password" />
        </div>
        <h1 id="NewPassword_SetNewPasswordError" class="ErrorMess"></h1>
        <div class="login-row">
            <label>ReType New Password: </label>
            <input type="password" id="Confirmation_SetNewPassword" name="RePassword" />
        </div>
        <h1 id="Confirmation_SetNewPasswordError" class="ErrorMess"></h1>
        <div class="login-reset-button">
            <div>
                <input type="submit" id="submit" name="submit" value="Login">
            </div>
            <div>
                <input type="reset" id="reset" name="reset" value="Reset">
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/Validation.js" asp-append-version="true"></script>
}