@page "/"
@model HomePageModel
@{
    ViewData["Title"] = "Home page";
	ViewData["HideElement"] = true;
}

<div>
    <h1><b>Welcome To 2DMania!</b></h1>
</div>
<div class="buttons-div">
    <button type="button" class="race-button" onclick="window.location.href='/cshtml/Race'">Race</button>
    <button type="button" class="login-button" onclick="window.location.href='/cshtml/Login'">Connect</button>
    <button type="button" class="login-button" onclick="window.location.href='/cshtml/test'">Test</button>
</div>
<div class="welcome-message">
	<p>@Html.Raw(Model.WelcomeMessage)</p>
</div>
