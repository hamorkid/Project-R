@page
@model Project_R_._8.Pages.cshtml.PasswordReset_AnswersModel
@{
	ViewData["Title"] = "Password Reset";
}

<div class="login-paper">
    <h1><u>Login</u></h1>

    <form method="post">
        @Html.AntiForgeryToken()

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p class="ErrorMess">@Model.ErrorMessage</p>
        }

        
        <label>Answer the following 2 questions</label>
        <br>
        <div class="login-row">
            <label style="width:220px">@Model.q1</label>
            <input type="text" asp-for="A1" style="width: 220px;" />
        </div>
        <div class="login-row">
            <label style="width:220px">@Model.q2</label>
            <input type="text" asp-for="A2" style="width: 220px;" />
        </div>
        <div class="login-reset-button">
            <div>
                <input type="submit" id="submit" name="submit" value="Login">
            </div>
            <div>
                <input type="reset" id="reset" name="reset" value="Reset">
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/FormValidation.js" asp-append-version="true"></script>
}