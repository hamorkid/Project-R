@page
@model Project_R_._8.Pages.cshtml.PasswordReset_AnswersModel
@{
	ViewData["Title"] = "Password Reset";
}

<div class="login-paper">
    <h1><u>Login</u></h1>

    <form onsubmit="return validateAnswersForm()">
        <label>Answer the following 2 questions</label>
        <br>
        <label></label> <!-- get questions for user -->
        <div class="login-row">
            <input type="text" id="answer1" name="code" style="width: 220px;" />
        </div>
        <div class="login-row">
            <input type="text" id="answer2" name="code" style="width: 220px;" />
        </div>
        <div class="login-reset-button">
            <div>
                <input type="submit" id="submit" name="submit" value="Login">
            </div>
            <div>
                <input type="reset" id="reset" name="reset" value="Reset">
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/FormValidation.js" asp-append-version="true"></script>
}