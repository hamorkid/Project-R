@page
@model Project_R_._8.Pages.cshtml.LoginModel
@{
	ViewData["Title"] = "Login To 2DMania";
}

<div class="login-paper">
    <h1><u>Login</u></h1>

    <form onsubmit="return ValidateForm_Login()">
        <div class="login-row">
            <label for="Username_Login">username: </label>
            <input type="text" id="Username_Login" name="Username" autocomplete="off" />
        </div>
        <h1 id="Username_LoginError" class="ErrorMess"></h1>
        <div>
            <div class="login-row">
                <label for="Password_Login">Password: </label>
                <input type="Password" id="Password_Login" name="Password" style="width: 220px;" />
            </div>
            <h1 id="Password_LoginError" class="ErrorMess"></h1>
            <p class="forgot">forgot your password? <a href="/cshtml/PasswordReset-Username">click here to reset</a> it</p>
        </div>
        <div class="login-reset-button">
            <div>
                <input type="submit" id="submit" name="submit" value="Login">
            </div>
            <div>
                <input type="reset" id="reset" name="reset" value="Reset">
            </div>
        </div>
        <p class="forgot">dont have an account? <a href="/cshtml/SignUp" style="text-decoration: none;">Sign Up</a></p>
    </form>
</div>

@section Scripts {
    <script src="~/js/Validation.js" asp-append-version="true"></script>
}