@page
@model Project_R_._8.Pages.cshtml.LeaderBoard_MonacoModel
@{
    ViewData["Title"] = "LeaderBoard - Monaco";
}
<h1>Monaco LeaderBoard</h1>
<div class="leaderboard-container">
    <div class="mapBar">
        <a href="/cshtml/LeaderBoard-LasVegas" class="maps">Las Vegas</a>
        <a href="/cshtml/LeaderBoard-Monaco" class="maps">Monaco</a>
        <a href="/cshtml/LeaderBoard-AbuDhabi" class="maps">Abu Dhabi</a>
    </div>
    <table>
        <tr>
            <th class="rank">rank</th>
            <th>player</th>
            <th>time</th>
        </tr>
        @if (Model.LeaderboardEntriesMO.Count > 0)
        {
            @foreach (var entry in Model.LeaderboardEntriesMO)
            {
                <tr>
                    <td class="rank">@entry.Rank</td>
                    <td>@entry.UserName</td>
                    <td>@entry.LapTime.ToString(@"mm\:ss\.ff")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" style="text-align: center;">No lap times yet</td>
            </tr>
        }
    </table>
</div>