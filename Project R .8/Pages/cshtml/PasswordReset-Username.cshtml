@page
@model Project_R_._8.Pages.cshtml.PasswordReset_UsernameModel
@{
	ViewData["Title"] = "Reset Your Password";
}

<div class="login-paper">
    <h1><u>Login</u></h1>

    <form method="post">
        @Html.AntiForgeryToken();
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p class="ErrorMess">@Model.ErrorMessage</p>
        }
        <div class="login-row">
            <label>username: </label>
            <input type="text" asp-for="UserName" style="width: 220px;" />
        </div>
        <h1 id="Username_ForgotPassError" class="ErrorMess"></h1>
        <div class="login-reset-button">
            <div>
                <input type="submit" id="submit" name="submit" value="Login">
            </div>
            <div>
                <input type="reset" id="reset" name="reset" value="Reset">
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/Validation.js" asp-append-version="true"></script>
}