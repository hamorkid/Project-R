@page
@model Project_R_._8.Pages.cshtml.testModel
@{
}

@Html.AntiForgeryToken()

<canvas id="myCanvas" style="height:100vh; width:100vw;">
	Your browser does not support the HTML canvas tag.
</canvas>

<canvas id="DashBoard">
	Your browser does not support the HTML canvas tag.
</canvas>
<canvas id="SpeedoMeter">
	Your browser does not support the HTML canvas tag.
</canvas>

<canvas id="SevenSegmentCanvas">
	Your browser does not support the HTML canvas tag.
</canvas>

<h1 id="SpeedNumber" style="position:absolute;right: 53px;bottom: 47px;margin: 0px">speed</h1>

<div id="skin-selector" style="position:absolute; top:10px; left:10px; z-index:100; background:rgba(0,0,0,0.6); padding:10px; border-radius:8px;">
	<p style="color:white; margin:0 0 5px 0; font-size:12px;">SELECT SKIN</p>
	<div id="skin-buttons" style="display:flex; gap:5px;">
	</div>
</div>

<button id="finishRaceBtn" style="position: fixed; bottom: 20px; right: 20px; padding: 10px 20px; background: red; color: white; border: none; border-radius: 5px; cursor: pointer; z-index: 1000;">
    Finish Race & Save
</button>

<div id="lap-display" style="
    position: fixed;
    top: 20px;
    right: 20px;
    background: rgba(0, 0, 0, 0.7);
    padding: 15px;
    border: 2px solid white;
    border-radius: 8px;
    z-index: 100;
"></div>



@section Scripts {
	<script>
        class Skins {
            constructor() {
                this.BLUE = "@Url.Content("~/assets/Skins/Blue.png")";
                this.GRAY = "@Url.Content("~/assets/Skins/Gray.png")";
                this.GREEN = "@Url.Content("~/assets/Skins/Green.png")";
                this.ORANGE = "@Url.Content("~/assets/Skins/Orange.png")";
                this.PINK = "@Url.Content("~/assets/Skins/Pink.png")";
                this.RED = "@Url.Content("~/assets/Skins/Red.png")";
                this.WHITE = "@Url.Content("~/assets/Skins/White.png")";
                this.SELECTED_SKIN = this.RED;

                this.ALL_SKINS = [
                    { name: "Blue", path: this.BLUE },
                    { name: "Gray", path: this.GRAY },
                    { name: "Green", path: this.GREEN },
                    { name: "Orange", path: this.ORANGE },
                    { name: "Pink", path: this.PINK },
                    { name: "Red", path: this.RED },
                    { name: "White", path: this.WHITE }
                ];
            }

            setSkin(skin) {
                this.SELECTED_SKIN = skin;
            }

            buildUI() {
                const container = document.getElementById("skin-buttons");
                this.ALL_SKINS.forEach(skin => {
                    const img = document.createElement("img");
                    img.src = skin.path;
                    img.title = skin.name;
                    img.style.cssText = "width:40px; height:40px; cursor:pointer; border:2px solid transparent; border-radius:4px;";

                    img.addEventListener("click", () => {
                        this.setSkin(skin.path);
                        // Highlight selected
                        container.querySelectorAll("img").forEach(i => i.style.borderColor = "transparent");
                        img.style.borderColor = "yellow";
                    });

                    // Highlight default skin
                    if (skin.path === this.SELECTED_SKIN) {
                        img.style.borderColor = "yellow";
                    }

                    container.appendChild(img);
                });
            }
        }

		class Maps{
			constructor() {
				this.MAP = "@Url.Content("~/assets/Maps/Las_VegasU.png")"
			}
			// Add More Maps When I Make Them
		}

        const skin = new Skins();
        skin.buildUI();

        document.getElementById("finishRaceBtn").addEventListener("click", async () => {
            if (lapTimer.warmupComplete && lapTimer.getLapCount() > 0) {
                console.log("Saving lap time:", lapTimer.getBestLap());

                try {
                    // Get the antiforgery token from the page
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    const response = await fetch("/cshtml/LeaderBoard-LasVegas?handler=SaveLap", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": token
                        },
                        body: JSON.stringify({
                            lapTimeSeconds: lapTimer.getBestLap()
                        })
                    });

                    console.log("Response status:", response.status);
                    const text = await response.text();
                    console.log("Response text:", text);

                    if (text) {
                        const data = JSON.parse(text);
                        console.log("Server response:", data);
                        alert(data.message);
                    } else {
                        alert("Empty response from server");
                    }
                } catch (error) {
                    console.error("Error:", error);
                    alert("Error: " + error.message);
                }
            }
        });
	</script>

	<script src="~/js/game.js" asp-append-version="true"></script>
	<script src="~/js/SevenSegmentDisplay.js" asp-append-version="true"></script>
}
@section Styles {
	<link rel="stylesheet" href="@Url.Content("~/css/Game.css")" asp-append-version="true">
}